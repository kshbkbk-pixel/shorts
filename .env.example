# 대본 (Claude). 기본 모델은 claude-opus-5-5, 대본 1편에 약 $0.03~0.05.
# 비용을 줄이려면 SHORTS_LLM_MODEL=claude-haiku-5-5 로 바꿔 품질을 비교해 보세요.
ANTHROPIC_API_KEY=
SHORTS_LLM_MODEL=claude-opus-5-5
SHORTS_LLM_EFFORT=low

# 음성 (하나 이상)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ko-KR-Neural2-A
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 이미지 (fal.ai FLUX 또는 OpenAI)
FAL_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# 자막 폰트 (.ttf/.otf). 비우면 시스템의 한글 폰트를 찾습니다. Noto Sans KR 또는 Pretendard 권장.
SHORTS_FONT=
